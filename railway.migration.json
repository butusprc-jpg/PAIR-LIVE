{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --omit=dev"
  },
  "deploy": {
    "startCommand": "npm run db:migrate -- --staging-apply",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 0,
    "numReplicas": 1
  }
}
