# Public HTTPS origin and LIFF Endpoint URL: https://your-domain.example/
NEXT_PUBLIC_APP_BASE_URL=https://your-domain.example
# LINE Login channel (LIFF and server-side access-token verification); never use Messaging channel here.
NEXT_PUBLIC_LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Admin Auth uses the LINE Login channel, with its own server allowlist.
ADMIN_AUTH_ORIGIN=https://your-domain.example
ADMIN_AUTH_ALLOWLIST_JSON=[]
# LINE OA Messaging API channel. Webhook: https://your-domain.example/api/line/webhook
LINE_LOGIN_PROVIDER_ID=
LINE_MESSAGING_PROVIDER_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Existing private database and service settings.
DATABASE_URL=
# Deliberately leave off until an approved delivery setup.
NOTIFICATION_DELIVERY_ENABLED=false
PAIR_WALLET_CUTOVER_VERIFIED=false

# Private slip image link signing: at least 32 random bytes, server only.
TOPUP_IMAGE_SIGNING_SECRET=

# V3: keep disabled until production retention policy and cron plan are approved
TOPUP_CLEANUP_ENABLED=false
CRON_SECRET=
