FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
# tsx is a development dependency required by the existing round:worker command.
RUN npm ci
COPY tsconfig.json ./
COPY lib ./lib
COPY modules ./modules
COPY scripts ./scripts
ENV NODE_ENV=production
USER node
CMD ["npm", "run", "round:worker"]
